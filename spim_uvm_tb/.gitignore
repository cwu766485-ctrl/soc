uvm_spim/formal/formal_demo_fail_session_rtdb/
# VC Formal session backups are generated databases, not source collateral.
# They contain special files that Windows Git cannot index.
uvm_spim/formal/*.rtdb.bak
uvm_spim/formal/*.rtdb.bak/**
uvm_spim/formal/formal_reset_session_rtdb.bak/
uvm_spim/formal/formal_session_rtdb.bak/
